# -----------------------------------------------
# docker-mailserver configuration
# Full reference: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
# -----------------------------------------------

# General
OVERRIDE_HOSTNAME=
LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=warn
# Restrict to one process per container (recommended for small setups)
ONE_DIR=1

# Accounts / login
# Use the setup script (see README) to create accounts.
PERMIT_DOCKER=none
# Auth: 0 = disabled, 1 = enabled. Keep enabled for real accounts.
ENABLE_SASLAUTHD=0

# TLS
# empty  -> no TLS (NOT recommended for production)
# letsencrypt -> use certs mounted from Let's Encrypt
# manual -> use SSL_CERT_PATH / SSL_KEY_PATH
# self-signed -> generated self-signed certs (testing only)
SSL_TYPE=

# Spam / virus / security
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1
ENABLE_SPAMASSASSIN=1
ENABLE_CLAMAV=1
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0
SPOOF_PROTECTION=1

# Spam handling
SPAMASSASSIN_SPAM_TO_INBOX=1
MOVE_SPAM_TO_JUNK=1

# IMAP / POP3
ENABLE_POP3=0
# Fetchmail for pulling mail from external accounts (optional)
ENABLE_FETCHMAIL=0

# Postfix message size limit (bytes). 0 = unlimited.
POSTFIX_MESSAGE_SIZE_LIMIT=10240000

# Relay host (uncomment to send outbound mail through an external SMTP relay,
# e.g. SendGrid/Mailgun, instead of delivering directly)
# RELAY_HOST=
# RELAY_PORT=587
# RELAY_USER=
# RELAY_PASSWORD=

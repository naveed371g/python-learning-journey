import re
import sys
from collections import Counter
file1=sys.argv[1]

# Count occurrences of each IP / error code in a log file
def parse_log(file1):
    ip_pattern = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")
# ip_pattern = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b") means, that \b is for boundary, ?: is for group, \d{1,3} upto three digits
# \. there is ., and {3} repeats three times 192.168.1, \d{3} three digits again for 192.168.1.1, then last \b for boundary
    counts = Counter()
    with open(file1) as f:
        for line in f:
            for ip in ip_pattern.findall(line):
                counts[ip] += 1
    return counts.most_common(5)

print(parse_log(file1))

